# GEMINI_API_KEY: Required for Gemini AI API calls (if enabled).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# NOTRACK_API_KEY: Private API key for NoTrack.ai API integration
NOTRACK_API_KEY="sk-notrack-..."

# NOTRACK_BASE_URL: Base URL for NoTrack.ai OpenAI-compatible endpoint
NOTRACK_BASE_URL="https://api.notrack.ai/v1"

# NOTRACK_MODEL: Default model for NoTrack.ai
NOTRACK_MODEL="notrack-uncensored"
